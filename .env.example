# Public URL of your deployed site. Used for canonical URLs, sitemap, Open Graph and share links.
# Local development works without changing this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets: where form submissions are saved. See google-apps-script/SETUP.md
# Keep these secret: never prefix them with NEXT_PUBLIC_.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=
